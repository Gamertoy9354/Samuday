# Google OAuth Client ID (same value as the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Backend API base URL. Leave empty for local dev — vite.config.ts already
# proxies /api to http://localhost:8000. In production this must be set to
# the deployed backend's public URL, e.g. https://samuday-backend.onrender.com
VITE_API_URL=
