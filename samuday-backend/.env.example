# Environment Settings
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/samuday
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/samuday

# Cache & Session
REDIS_URL=redis://localhost:6379/0

# Search
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKey123456!

# Security
JWT_SECRET=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Fernet 32-byte url-safe base64 key for PII/phone encryption
PII_ENCRYPTION_KEY=your-32-byte-base64-key-here

# OTP / Notification Mocks
MOCK_OTP=True
MOCK_OTP_CODE=123456

# Object Storage
S3_BUCKET_NAME=samuday-kyc
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=