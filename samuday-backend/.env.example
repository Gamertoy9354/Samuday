# Environment Settings
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/samuday
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/samuday

# Cache & Session
REDIS_URL=redis://localhost:6379/0

# Search
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKey123456!

# Security
JWT_SECRET=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Payment gateway webhook signing secret (HMAC-SHA256). Any random string works —
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=your-random-payment-webhook-secret-here

# Fernet 32-byte url-safe base64 key for PII/phone encryption. MUST be a valid
# Fernet key, generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=your-32-byte-base64-key-here

# OTP / Notification Mocks — MOCK_OTP must be False in any real deployment.
# There is no real SMS gateway integrated: with MOCK_OTP=False, phone/OTP login
# will safely reject rather than work, until a real SMS provider is added.
# Google Sign-In does not depend on this and works in production as-is.
MOCK_OTP=True
MOCK_OTP_CODE=123456

# Object Storage (legacy/unused — S3 vars are declared but nothing reads them)
S3_BUCKET_NAME=samuday-kyc
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Supabase Storage — required. Used for ALL uploaded/AI-generated images instead
# of local disk, since Render's free/ephemeral instances lose local files on
# restart. SUPABASE_SERVICE_ROLE_KEY is a secret admin key (Project Settings ->
# API Keys -> service_role) — never expose it to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Delhivery shipping (optional). Empty = simulated/estimated rates & tracking,
# clearly labeled to users, until a real Delhivery account is connected.
DELHIVERY_API_KEY=

# Google Maps (optional). Empty = GPS/address geocoding uses free OpenStreetMap
# Nominatim instead — works either way, no billing required for the free path.
GOOGLE_MAPS_API_KEY=

# Platform fee taken on each order (0.05 = 5%), and an estimated payment-gateway
# processing cost used only for internal revenue bookkeeping (no real gateway
# is connected yet — see the payments conversation in project history).
PLATFORM_FEE_RATE=0.05
ESTIMATED_GATEWAY_FEE_RATE=0.02

# Google OAuth (Google Cloud Console -> Credentials -> OAuth Client ID, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend/Frontend public URLs — in production these are two DIFFERENT hosts,
# not just different ports. BACKEND_URL is used to build links to uploaded and
# AI-generated images, so it must be this API's own public URL, not the frontend's.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
# Free image generation/editing fallback (server-side only) — create at dash.cloudflare.com under Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=