# ==========================================
# Root .gitignore for Samuday Monorepo
# ==========================================

# Environment & Secrets (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.env

# Python & Virtual Environments
samuday-backend/.venv/
samuday-backend/venv/
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# Node.js & Frontend Build Outputs
node_modules/
samuday-frontend/node_modules/
samuday-frontend/dist/
samuday-frontend/dist-ssr/
dist/
build/

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & SQLite
*.db
*.sqlite
*.sqlite3

# Temporary / Generated Seed SQL Files
*.sql
!schema.sql
!schema_supabase.sql

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
